
# ==========================================
# OPENAI CONFIGURATION
# ==========================================

OPENAI_API_KEY=your_openai_api_key_here


# ==========================================
# POSTGRESQL CONFIGURATION
# ==========================================

POSTGRES_ADMIN_PASSWORD=ChangeThis_AdminPassword_123!

POSTGRES_AGENT_PASSWORD=ChangeThis_AgentPassword_456!

POSTGRES_ADMIN_DSN=postgresql://parking_admin:ChangeThis_AdminPassword_123!@localhost:5432/parking

POSTGRES_AGENT_DSN=postgresql://agent_role:ChangeThis_AgentPassword_456!@localhost:5432/parking


# ==========================================
# WEAVIATE CONFIGURATION
# ==========================================

WEAVIATE_HOST=localhost

WEAVIATE_HTTP_PORT=8080

WEAVIATE_GRPC_PORT=50051


# ==========================================
# LANGSMITH CONFIGURATION (OPTIONAL)
# ==========================================

LANGSMITH_API_KEY=

LANGSMITH_TRACING=false


# ==========================================
# ADMINISTRATOR EMAIL CONFIGURATION
# ==========================================

# Administrator email address
ADMIN_EMAIL_FROM=parkingbot@example.com
ADMIN_EMAIL_TO=admin@example.com

# SMTP - Sending reservation requests
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=parkingbot@example.com
SMTP_PASSWORD=your_app_password
SMTP_USE_SSL=false
SMTP_STARTTLS=true

# IMAP - Receiving administrator replies
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USERNAME=parkingbot@example.com
IMAP_PASSWORD=your_app_password
IMAP_USE_SSL=true

# Check for administrator replies every 30 seconds
ADMIN_EMAIL_POLL_INTERVAL=30